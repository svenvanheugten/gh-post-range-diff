cabal-version:      3.0
name:               gh-post-range-diff
version:            0.4.2
synopsis:           Post `git range-diff` on a PR after a force-push
license:            MIT
license-file:       LICENSE
author:             Sven van Heugten
build-type:         Simple

executable gh-post-range-diff
    main-is:          Main.hs
    other-modules:    Git, RangeDiffRenderer
    default-language: GHC2021
    ghc-options:      -O2 -Wall
    build-depends:
        base,
        process,
        extra,

-- Builds real git repos, so it needs `git` on PATH at run time.
test-suite unit
    type:             exitcode-stdio-1.0
    main-is:          Test.hs
    other-modules:    Git, RangeDiffRenderer
    default-language: GHC2021
    ghc-options:      -Wall
    build-depends:
        base,
        process,
        directory,
        extra,
        hspec,
