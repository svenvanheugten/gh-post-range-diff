cabal-version:      3.0
name:               gh-post-range-diff
version:            0.4.2
synopsis:           Post `git range-diff` on a PR after a force-push
description:
    A GitHub Action, and a CLI, that comments on a pull request with the
    `git range-diff` of a force-push, so reviewers can see what changed
    between the old and the new version of the branch.

homepage:           https://github.com/svenvanheugten/gh-post-range-diff
bug-reports:        https://github.com/svenvanheugten/gh-post-range-diff/issues
license:            MIT
license-file:       LICENSE
author:             Sven van Heugten
maintainer:         sven@memcmp.org
copyright:          (c) 2026 Sven van Heugten
category:           Development
build-type:         Simple
tested-with:        GHC == 9.10.*

extra-doc-files:
    README.md
    CHANGELOG.md

source-repository head
    type:     git
    location: https://github.com/svenvanheugten/gh-post-range-diff.git

common defaults
    default-language:   GHC2021
    ghc-options:
        -Werror -Wall -Wcompat -Wredundant-constraints -Wunused-packages

-- Taking a range-diff, and reading what one says. Knows nothing of pull
-- requests, of GitHub, or of the tool built on top of it, so it can only be
-- depended on the one way round.
library rangediff
    import:           defaults
    hs-source-dirs:   rangediff/src
    exposed-modules:
        RangeDiff
        RangeDiff.CommitSha

    build-depends:
        base    >=4.20 && <5,
        process >=1.6  && <1.7,

-- What it takes to try `rangediff` against real repos: a scenario of rewrites,
-- planned and then carried out. Written for the range-diff tests, and used by
-- the tool's tests too, which is as far as the dependency goes: nothing here
-- knows about `GhPostRangeDiff` either.
library rangediff-test-support
    import:           defaults
    hs-source-dirs:   rangediff/testlib
    exposed-modules:
        RangeDiff.Test.Gen
        RangeDiff.Test.Git
        RangeDiff.Test.Plan
        RangeDiff.Test.Repo

    build-depends:
        base       >=4.20 && <5,
        directory  >=1.3  && <1.4,
        extra      >=1.7  && <2,
        process    >=1.6  && <1.7,
        QuickCheck >=2.14 && <3,
        temporary  >=1.3  && <1.4,
        gh-post-range-diff:rangediff,

-- Builds real repos, rewriting them with jujutsu and reading them with git, so
-- it needs both `jj` and `git` on PATH at run time.
test-suite rangediff-spec
    import:           defaults
    type:             exitcode-stdio-1.0
    hs-source-dirs:   rangediff/test
    main-is:          Spec.hs
    other-modules:
        RangeDiffSpec
    build-tool-depends: hspec-discover:hspec-discover >=2.10 && <3
    build-depends:
        base       >=4.20 && <5,
        hspec      >=2.10 && <3,
        QuickCheck >=2.14 && <3,
        gh-post-range-diff:{rangediff, rangediff-test-support},

library
    import:           defaults
    hs-source-dirs:   src
    exposed-modules:
        GhPostRangeDiff.Comment
        GhPostRangeDiff.Git
        GhPostRangeDiff.GitHub
        GhPostRangeDiff.Render
        GhPostRangeDiff.Run

    build-depends:
        base    >=4.20 && <5,
        process >=1.6  && <1.7,
        extra   >=1.7  && <2,
        gh-post-range-diff:rangediff,

executable gh-post-range-diff
    import:           defaults
    hs-source-dirs:   app
    main-is:          Main.hs
    ghc-options:      -O2
    build-depends:
        base    >=4.20 && <5,
        gh-post-range-diff,
        gh-post-range-diff:rangediff,

-- Builds real repos, rewriting them with jujutsu and reading them with git, so
-- it needs both `jj` and `git` on PATH at run time.
test-suite spec
    import:           defaults
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    other-modules:
        GhPostRangeDiff.FakeGitHub
        GhPostRangeDiff.RenderSpec
        GhPostRangeDiff.RunSpec
    build-tool-depends: hspec-discover:hspec-discover >=2.10 && <3
    build-depends:
        base       >=4.20 && <5,
        hspec      >=2.10 && <3,
        QuickCheck >=2.14 && <3,
        temporary  >=1.3  && <1.4,
        gh-post-range-diff,
        gh-post-range-diff:{rangediff, rangediff-test-support},
